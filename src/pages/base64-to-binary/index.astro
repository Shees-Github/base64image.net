---
import ToolLayout from '../../layouts/ToolLayout.astro';
const bodyHtml = `<main>
        <div class="trust-note">
            <strong>🔒 Privacy First:</strong> All conversion happens locally in your browser. Your data never leaves your device.
        </div>

        <div style="display: flex; justify-content: center; gap: 10px; margin: 30px 0;">
            <button id="btnToBinary" class="btn-primary" onclick="b64binSetMode('toBinary')" style="min-width: 190px;">
                <i class="fas fa-lock"></i> Base64 → Binary
            </button>
            <button id="btnToBase64" class="btn-secondary" onclick="b64binSetMode('toBase64')" style="min-width: 190px;">
                <i class="fas fa-unlock"></i> Binary → Base64
            </button>
        </div>

        <section class="tool-section">
            <div class="input-group">
                <label id="b64binInputLabel" for="b64binInput">Paste a Base64 string</label>
                <textarea id="b64binInput" placeholder="Paste a Base64 string here..." rows="6" oninput="b64binRun()"></textarea>
            </div>

            <div class="error" id="b64binError" style="display:none;"></div>

            <div class="input-group" id="b64binOutputGroup" style="display:none;">
                <label id="b64binOutputLabel">Binary output</label>
                <textarea id="b64binOutput" rows="8" readonly></textarea>
            </div>

            <div class="actions">
                <button id="b64binCopy" class="btn-secondary" onclick="b64binCopy()" style="display:none;">
                    <i class="fas fa-copy"></i> Copy Output
                </button>
                <button class="btn-secondary" onclick="b64binClear()">
                    <i class="fas fa-trash"></i> Clear
                </button>
            </div>
        </section>

        <article class="content-section">
            <h2><i class="fas fa-question-circle"></i> What Is Base64 to Binary Conversion?</h2>
            <p>
                Base64 to binary conversion decodes a Base64 string into its raw bit pattern — the sequence of 1s and 0s that make up the underlying bytes — rather than into readable text or an image. It's mainly used for learning how the encoding works, debugging byte-level issues, or comparing output against a spec. This is a different tool from the <a href="/base64-file-decoder/">Base64 file decoder</a>, which reconstructs a downloadable file instead of showing the bit pattern.
            </p>
            <p>
                For the conceptual comparison between the two encodings — size overhead, character sets, when to use which — see <a href="/base64-vs-binary/">Base64 vs Binary</a>.
            </p>

            <h2><i class="fas fa-cogs"></i> How Does the Conversion Work?</h2>
            <p>
                <strong>Base64 → Binary:</strong> the tool decodes the Base64 string to raw bytes with <code>atob()</code>, then converts each byte to an 8-bit binary string with leading zeros preserved, space-separated for readability.
            </p>
            <p>
                <strong>Binary → Base64:</strong> the tool reads the input as space- or line-separated 8-bit groups, converts each group back to a byte, and re-encodes the byte sequence with <code>btoa()</code>.
            </p>
            <div class="code-example">
                <div class="code-example-head"><span>JavaScript</span></div>
                <pre><code>// Base64 -> binary
const bytes = atob(b64Str);
const bits = [...bytes].map(c => c.charCodeAt(0).toString(2).padStart(8, '0')).join(' ');

// Binary -> Base64
const bytes2 = bits.split(/\\s+/).map(b => String.fromCharCode(parseInt(b, 2))).join('');
const b64 = btoa(bytes2);</code></pre>
            </div>

            <h2><i class="fas fa-table"></i> Example</h2>
            <table class="reference-table">
                <thead><tr><th>Input</th><th>Base64</th><th>Binary (per byte)</th></tr></thead>
                <tbody>
                    <tr><td>"Hi"</td><td><code>SGk=</code></td><td><code>01001000 01101001</code></td></tr>
                </tbody>
            </table>

            <h2><i class="fas fa-shield-alt"></i> Is This Converter Private?</h2>
            <p>
                Yes. All conversion runs locally using <code>atob()</code>/<code>btoa()</code> and basic string operations — nothing is uploaded to a server.
            </p>

            <h2>Frequently Asked Questions</h2>
            <div class="faq-item">
                <h3>What does Base64 look like in binary?</h3>
                <p>Each character in a Base64 string represents 6 bits of the original data. Decoding to binary shows the underlying bytes in standard 8-bit groups, not the 6-bit Base64 index values.</p>
            </div>
            <div class="faq-item">
                <h3>Is Base64 more efficient than raw binary?</h3>
                <p>No — Base64 is about 33% larger than the raw binary it represents, since it trades compactness for the ability to travel safely through text-only systems. See <a href="/base64-vs-binary/">Base64 vs Binary</a> for the full comparison.</p>
            </div>
            <div class="faq-item">
                <h3>Can I convert a binary file directly, not just a bit string?</h3>
                <p>For encoding an actual binary file to Base64, use the <a href="/base64-file-encoder/">file encoder</a>. This page is specifically for viewing/converting the 1s-and-0s bit representation.</p>
            </div>
        </article>
    </main>`;
---
<ToolLayout
  title="Base64 to Binary Converter — Convert Base64 to 1s and 0s Online"
  description="Free Base64 to binary converter. Decode a Base64 string to its raw binary (1s and 0s) representation, or convert binary back to Base64. Runs in your browser."
  canonical="https://base64image.net/base64-to-binary/"
  h1="Base64 to Binary Converter"
  mono="// toString(2)"
  lede="Convert a Base64 string to its raw binary (1s and 0s) representation, or convert binary back to Base64."
  tag="convert"
  tagLabel="Converter"
  breadcrumbs={[{label:'Home',href:'/'},{label:'Converters',href:'#'},{label:'Base64 → Binary'}]}
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
            "@type": "Question",
            "name": "What does Base64 look like in binary?",
            "acceptedAnswer": { "@type": "Answer", "text": "Each character in a Base64 string represents 6 bits of the original data. Decoding to binary shows the underlying bytes in standard 8-bit groups, not the 6-bit Base64 index values." }
        }, {
            "@type": "Question",
            "name": "Is Base64 more efficient than raw binary?",
            "acceptedAnswer": { "@type": "Answer", "text": "No — Base64 is about 33% larger than the raw binary it represents, since it trades compactness for safe transport through text-only systems." }
        }, {
            "@type": "Question",
            "name": "Can I convert a binary file directly, not just a bit string?",
            "acceptedAnswer": { "@type": "Answer", "text": "For encoding an actual binary file to Base64, use the file encoder. This tool is specifically for viewing and converting the 1s-and-0s bit representation." }
        }]
    }
        </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem", "position": 1, "name": "Home", "item": "https://base64image.net/"
        }, {
            "@type": "ListItem", "position": 2, "name": "Base64 to Binary Converter", "item": "https://base64image.net/base64-to-binary/"
        }]
    }
        </script>
  </Fragment>
  <Fragment set:html={bodyHtml} />
  <style is:inline>
    .code-example { margin: 20px 0; border: 1px solid var(--border, #2a2f3a); border-radius: var(--radius, 8px); overflow: hidden; }
    .code-example-head { padding: 8px 14px; background: var(--bg-card, #161a22); font-size: 0.85rem; color: var(--fg-mute, #9aa3b3); }
    .code-example pre { margin: 0; padding: 14px; overflow-x: auto; }
  </style>
  <script is:inline>
    var b64binMode = 'toBinary';

    function b64binSetMode(mode) {
      b64binMode = mode;
      document.getElementById('btnToBinary').className = mode === 'toBinary' ? 'btn-primary' : 'btn-secondary';
      document.getElementById('btnToBase64').className = mode === 'toBase64' ? 'btn-primary' : 'btn-secondary';
      document.getElementById('b64binInputLabel').textContent = mode === 'toBinary' ? 'Paste a Base64 string' : 'Paste a binary string (e.g. 01001000 01101001)';
      document.getElementById('b64binInput').placeholder = mode === 'toBinary' ? 'Paste a Base64 string here...' : 'Paste 8-bit binary groups here...';
      document.getElementById('b64binOutputLabel').textContent = mode === 'toBinary' ? 'Binary output' : 'Base64 output';
      b64binRun();
    }

    function b64binRun() {
      var input = document.getElementById('b64binInput').value.trim();
      var errorEl = document.getElementById('b64binError');
      var outputEl = document.getElementById('b64binOutput');
      var outputGroup = document.getElementById('b64binOutputGroup');
      var copyBtn = document.getElementById('b64binCopy');

      errorEl.style.display = 'none';
      errorEl.textContent = '';
      outputGroup.style.display = 'none';
      copyBtn.style.display = 'none';
      outputEl.value = '';

      if (!input) return;

      try {
        if (b64binMode === 'toBinary') {
          var bytes = atob(input);
          var bits = [];
          for (var i = 0; i < bytes.length; i++) {
            bits.push(bytes.charCodeAt(i).toString(2).padStart(8, '0'));
          }
          outputEl.value = bits.join(' ');
        } else {
          var groups = input.replace(/[^01\s]/g, '').trim().split(/\s+/).filter(Boolean);
          if (groups.length === 0) throw new Error('No valid binary (0/1) groups found.');
          var chars = '';
          for (var j = 0; j < groups.length; j++) {
            var g = groups[j];
            if (g.length !== 8) throw new Error('Each binary group must be exactly 8 bits (found "' + g + '").');
            chars += String.fromCharCode(parseInt(g, 2));
          }
          outputEl.value = btoa(chars);
        }
        outputGroup.style.display = 'block';
        copyBtn.style.display = 'inline-block';
      } catch (e) {
        errorEl.textContent = e.message || 'Invalid input.';
        errorEl.style.display = 'block';
      }
    }

    function b64binCopy() {
      var outputEl = document.getElementById('b64binOutput');
      if (!outputEl.value) return;
      navigator.clipboard.writeText(outputEl.value).then(function () {
        var btn = document.getElementById('b64binCopy');
        var original = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
        setTimeout(function () { btn.innerHTML = original; }, 2000);
      });
    }

    function b64binClear() {
      document.getElementById('b64binInput').value = '';
      document.getElementById('b64binOutput').value = '';
      document.getElementById('b64binError').style.display = 'none';
      document.getElementById('b64binOutputGroup').style.display = 'none';
      document.getElementById('b64binCopy').style.display = 'none';
    }
  </script>
</ToolLayout>
