---
import ToolLayout from '../../layouts/ToolLayout.astro';
const bodyHtml = `<main x-data="base64Audio()">
        <div class="trust-note">
            <strong>🔒 Privacy First:</strong> All conversion happens locally in your browser. Your data never leaves your device.
        </div>

        <div style="display: flex; justify-content: center; gap: 10px; margin: 30px 0;">
            <button
                @click="mode = 'encode'; clearAll()"
                :class="mode === 'encode' ? 'btn-primary' : 'btn-secondary'"
                style="min-width: 170px;">
                <i class="fas fa-lock"></i> Encode (Audio → Base64)
            </button>
            <button
                @click="mode = 'decode'; clearAll()"
                :class="mode === 'decode' ? 'btn-primary' : 'btn-secondary'"
                style="min-width: 170px;">
                <i class="fas fa-unlock"></i> Decode (Base64 → Audio)
            </button>
        </div>

        <section class="tool-section" x-show="mode === 'encode'">
            <div class="input-group">
                <label for="audioFile">Upload audio file (.mp3, .wav, .ogg):</label>
                <input type="file" id="audioFile" @change="encodeAudio($event)" accept=".mp3,.wav,.ogg,audio/mpeg,audio/wav,audio/ogg" class="file-input">
                <div class="error" x-show="error" x-text="error"></div>
            </div>

            <div class="preview-container" x-show="base64Output">
                <h2><i class="fas fa-play-circle"></i> Preview</h2>
                <audio controls :src="dataUri" style="width:100%;margin-bottom:16px"></audio>
                <h2><i class="fas fa-code"></i> Base64 Output</h2>
                <div class="input-group">
                    <textarea :value="base64Output" readonly rows="8"></textarea>
                </div>
                <div class="image-info" x-show="fileInfo">
                    <p><strong>Filename:</strong> <span x-text="fileInfo.name"></span></p>
                    <p><strong>Size:</strong> <span x-text="fileInfo.size"></span></p>
                    <p><strong>Base64 Length:</strong> <span x-text="base64Output.length"></span> characters</p>
                </div>
                <button @click="copyBase64" class="btn-primary">
                    <i class="fas fa-copy"></i> <span x-text="copyButtonText"></span>
                </button>
            </div>
        </section>

        <section class="tool-section" x-show="mode === 'decode'">
            <div class="input-group">
                <label for="base64Input">Paste your Base64 string:</label>
                <textarea id="base64Input" x-model="base64Input" placeholder="Paste your Base64 audio string here..." rows="8" @input="tryPreview"></textarea>
                <div class="error" x-show="error" x-text="error"></div>
            </div>

            <div class="input-group">
                <label for="audioFormat">Audio format:</label>
                <select id="audioFormat" x-model="outputFormat" @change="tryPreview" class="format-select">
                    <option value="mp3">.mp3 (MPEG Audio)</option>
                    <option value="wav">.wav (Waveform Audio)</option>
                    <option value="ogg">.ogg (Ogg Vorbis)</option>
                </select>
            </div>

            <div class="actions">
                <button @click="decodeAudio" class="btn-primary">Decode &amp; Download</button>
            </div>

            <div x-show="previewSrc">
                <h2><i class="fas fa-play-circle"></i> Preview</h2>
                <audio controls :src="previewSrc" style="width:100%"></audio>
            </div>

            <div class="preview-container" x-show="decodedInfo">
                <div class="image-info" x-show="decodedInfo">
                    <p><strong>Size:</strong> <span x-text="decodedInfo.size"></span></p>
                    <p><strong>Status:</strong> <span style="color:#28a745;">✓ Downloaded</span></p>
                </div>
            </div>
        </section>

        <div class="actions" x-show="base64Output || decodedInfo">
            <button @click="clearAll" class="btn-secondary">Clear</button>
        </div>

        <article class="content-section">
            <h2><i class="fas fa-question-circle"></i> Why Convert Audio to Base64?</h2>
            <p>
                Base64-encoding an audio file turns it into a text string that can be embedded directly in HTML with <code>&lt;audio src="data:audio/mpeg;base64,..."&gt;</code>, stored in a JSON payload, or transmitted through text-only channels — the same reasoning that applies to <a href="/base64-image-encoder/">images</a> and <a href="/base64-to-pdf/">PDFs</a>, just for sound.
            </p>
            <ul>
                <li><strong>Voice message apps:</strong> short voice clips sent as Base64 inside a chat API payload, avoiding a separate media-upload endpoint.</li>
                <li><strong>Text-to-speech APIs:</strong> services like AWS Polly and Google Cloud TTS return generated audio as a Base64 string in the JSON response.</li>
                <li><strong>Offline-capable web apps:</strong> small sound effects (UI clicks, notification chimes) inlined so the app has no extra network dependency after first load.</li>
                <li><strong>Embedded audio in email or SVG:</strong> contexts where linking an external audio file isn't practical.</li>
            </ul>

            <h2><i class="fas fa-play-circle"></i> Can You Preview Base64 Audio in the Browser?</h2>
            <p>
                Yes — an <code>&lt;audio&gt;</code> element accepts a data URI directly in its <code>src</code>, exactly like <code>&lt;img&gt;</code> does for images. The decoder above generates a live preview player automatically once you paste a valid Base64 audio string and pick the correct format.
            </p>

            <h2><i class="fas fa-exclamation-triangle"></i> Should You Base64-Encode Large Audio Files?</h2>
            <p>
                No — Base64 adds roughly 33% overhead, and unlike a linked <code>.mp3</code> file, an inlined audio string can't be streamed progressively or cached separately from the page that contains it. This approach works well for short clips (a few seconds to a couple of minutes) but not for full songs, podcasts, or long recordings, which should stay as normal linked files.
            </p>

            <h2><i class="fas fa-table"></i> Audio MIME Type Reference</h2>
            <table class="reference-table">
                <thead><tr><th>Format</th><th>MIME Type</th><th>Data URI Prefix</th></tr></thead>
                <tbody>
                    <tr><td>MP3</td><td><code>audio/mpeg</code></td><td><code>data:audio/mpeg;base64,</code></td></tr>
                    <tr><td>WAV</td><td><code>audio/wav</code></td><td><code>data:audio/wav;base64,</code></td></tr>
                    <tr><td>OGG</td><td><code>audio/ogg</code></td><td><code>data:audio/ogg;base64,</code></td></tr>
                </tbody>
            </table>
            <p>
                See the full <a href="/base64-mime-types/">MIME type list</a> for every format the browser recognizes.
            </p>

            <h2><i class="fas fa-shield-alt"></i> Is This Converter Private?</h2>
            <p>
                Yes. Both directions run locally using the FileReader, Blob, and <code>URL.createObjectURL</code> APIs — your audio never leaves your browser.
            </p>

            <h2>Frequently Asked Questions</h2>
            <div class="faq-item">
                <h3>How do I convert an MP3 to Base64?</h3>
                <p>Click Encode, upload your <code>.mp3</code> file, and copy the generated Base64 string. A playback preview appears automatically so you can confirm it encoded correctly.</p>
            </div>
            <div class="faq-item">
                <h3>Can I play Base64 audio directly in a webpage?</h3>
                <p>Yes — use <code>&lt;audio controls src="data:audio/mpeg;base64,..."&gt;&lt;/audio&gt;</code>. Browsers decode and play the data URI exactly like a linked file.</p>
            </div>
            <div class="faq-item">
                <h3>Why do I need to select the audio format when decoding?</h3>
                <p>Unlike images, audio containers don't have one universal signature the browser can sniff reliably before playback — selecting MP3/WAV/OGG ensures the correct MIME type and file extension on download.</p>
            </div>
        </article>
    </main>`;
---
<ToolLayout
  title="MP3 to Base64 Converter — Encode/Decode Audio to Base64 Online"
  description="Free MP3/WAV/OGG to Base64 converter with instant playback preview. Encode audio to Base64 or decode Base64 back to a playable audio file. Runs in your browser."
  canonical="https://base64image.net/mp3-to-base64/"
  h1="MP3 to Base64 Converter"
  mono="// audio data URI"
  lede="Encode MP3/WAV/OGG audio to Base64, or decode Base64 back to a playable audio file — with an instant preview player."
  tag="convert"
  tagLabel="Converter"
  breadcrumbs={[{label:'Home',href:'/'},{label:'Converters',href:'#'},{label:'Base64 → Audio'}]}
>
  <Fragment slot="head">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
            "@type": "Question",
            "name": "How do I convert an MP3 to Base64?",
            "acceptedAnswer": { "@type": "Answer", "text": "Click Encode, upload your .mp3 file, and copy the generated Base64 string. A playback preview appears automatically." }
        }, {
            "@type": "Question",
            "name": "Can I play Base64 audio directly in a webpage?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes, using an audio element with a data:audio/mpeg;base64,... src attribute. Browsers decode and play the data URI exactly like a linked file." }
        }, {
            "@type": "Question",
            "name": "Why do I need to select the audio format when decoding?",
            "acceptedAnswer": { "@type": "Answer", "text": "Audio containers don't have one universal signature the browser can sniff reliably before playback, so selecting MP3/WAV/OGG ensures the correct MIME type and file extension." }
        }]
    }
        </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem", "position": 1, "name": "Home", "item": "https://base64image.net/"
        }, {
            "@type": "ListItem", "position": 2, "name": "MP3 to Base64 Converter", "item": "https://base64image.net/mp3-to-base64/"
        }]
    }
        </script>
  </Fragment>
  <Fragment set:html={bodyHtml} />
  <style is:inline>
    .format-select {
      width: 100%; background: #06080c; border: 1px solid var(--line);
      border-radius: var(--radius-sm); padding: 12px 14px; color: var(--fg);
      font-family: var(--font-mono); font-size: 13px; outline: none;
    }
    .format-select:focus { border-color: var(--violet); box-shadow: 0 0 0 3px rgba(124,92,255,0.15); }
  </style>
  <script is:inline>function base64Audio() {
            const MIME = { mp3: 'audio/mpeg', wav: 'audio/wav', ogg: 'audio/ogg' };
            return {
                mode: 'encode',
                base64Input: '',
                base64Output: '',
                dataUri: '',
                outputFormat: 'mp3',
                error: '',
                fileInfo: null,
                decodedInfo: null,
                previewSrc: '',
                copyButtonText: 'Copy Base64',

                encodeAudio(event) {
                    this.error = '';
                    this.base64Output = '';
                    this.dataUri = '';
                    this.fileInfo = null;

                    const file = event.target.files[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            this.dataUri = e.target.result;
                            this.base64Output = e.target.result.split(',')[1] || '';
                            this.fileInfo = { name: file.name, size: this.formatBytes(file.size) };
                        } catch (err) {
                            this.error = 'Failed to encode file. Please try again.';
                        }
                    };
                    reader.onerror = () => { this.error = 'Failed to read file.'; };
                    reader.readAsDataURL(file);
                },

                cleanBase64() {
                    let base64String = this.base64Input.trim();
                    const dataUriMatch = base64String.match(/^data:[^;]+;base64,(.+)$/);
                    if (dataUriMatch) base64String = dataUriMatch[1];
                    return base64String.replace(/\s/g, '');
                },

                tryPreview() {
                    this.previewSrc = '';
                    if (!this.base64Input.trim()) return;
                    try {
                        const base64String = this.cleanBase64();
                        if (!/^[A-Za-z0-9+/]*={0,2}$/.test(base64String)) return;
                        this.previewSrc = 'data:' + MIME[this.outputFormat] + ';base64,' + base64String;
                    } catch (e) { /* ignore */ }
                },

                decodeAudio() {
                    this.error = '';
                    this.decodedInfo = null;

                    if (!this.base64Input.trim()) return;

                    try {
                        const base64String = this.cleanBase64();

                        if (!/^[A-Za-z0-9+/]*={0,2}$/.test(base64String)) {
                            throw new Error('Invalid Base64 string. Only A-Z, a-z, 0-9, +, /, and = are allowed.');
                        }

                        const binaryString = atob(base64String);
                        const bytes = new Uint8Array(binaryString.length);
                        for (let i = 0; i < binaryString.length; i++) {
                            bytes[i] = binaryString.charCodeAt(i);
                        }

                        const mime = MIME[this.outputFormat] || 'audio/mpeg';
                        const blob = new Blob([bytes], { type: mime });
                        const url = URL.createObjectURL(blob);
                        const filename = 'decoded-audio.' + this.outputFormat;

                        const link = document.createElement('a');
                        link.href = url;
                        link.download = filename;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        URL.revokeObjectURL(url);

                        this.decodedInfo = { size: this.formatBytes(bytes.length) };
                    } catch (err) {
                        this.error = err.message || 'Failed to decode Base64 string. Please check your input.';
                        this.decodedInfo = null;
                    }
                },

                formatBytes(bytes) {
                    if (bytes === 0) return '0 Bytes';
                    const k = 1024;
                    const sizes = ['Bytes', 'KB', 'MB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
                },

                copyBase64() {
                    if (!this.base64Output) return;
                    navigator.clipboard.writeText(this.base64Output).then(() => {
                        this.copyButtonText = 'Copied!';
                        setTimeout(() => { this.copyButtonText = 'Copy Base64'; }, 2000);
                    }).catch(() => { this.error = 'Failed to copy to clipboard.'; });
                },

                clearAll() {
                    this.base64Input = '';
                    this.base64Output = '';
                    this.dataUri = '';
                    this.error = '';
                    this.fileInfo = null;
                    this.decodedInfo = null;
                    this.previewSrc = '';
                    this.copyButtonText = 'Copy Base64';
                    const fileInput = document.getElementById('audioFile');
                    if (fileInput) fileInput.value = '';
                }
            }
        }</script>
</ToolLayout>
