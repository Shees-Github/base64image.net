---
import ToolLayout from '../../layouts/ToolLayout.astro';
const bodyHtml = `<main x-data="base64ToExcel()">
        <div class="trust-note">
            <strong>🔒 Privacy First:</strong> All conversion happens locally in your browser. Your data never leaves your device.
        </div>

        <div style="display: flex; justify-content: center; gap: 10px; margin: 30px 0;">
            <button
                @click="mode = 'encode'; clearAll()"
                :class="mode === 'encode' ? 'btn-primary' : 'btn-secondary'"
                style="min-width: 150px;">
                <i class="fas fa-lock"></i> Encode (Excel → Base64)
            </button>
            <button
                @click="mode = 'decode'; clearAll()"
                :class="mode === 'decode' ? 'btn-primary' : 'btn-secondary'"
                style="min-width: 150px;">
                <i class="fas fa-unlock"></i> Decode (Base64 → Excel)
            </button>
        </div>

        <section class="tool-section" x-show="mode === 'encode'">
            <div class="input-group">
                <label for="excelFile">Upload Excel/CSV file (.xlsx, .xls, .csv):</label>
                <input
                    type="file"
                    id="excelFile"
                    @change="encodeExcel($event)"
                    accept=".xlsx,.xls,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv"
                    class="file-input">
                <div class="error" x-show="error" x-text="error"></div>
            </div>

            <div class="preview-container" x-show="base64Output">
                <h2><i class="fas fa-code"></i> Base64 Output</h2>
                <div class="input-group">
                    <textarea x-model="base64Output" readonly rows="10" placeholder="Base64 string will appear here..."></textarea>
                </div>
                <div class="image-info" x-show="fileInfo">
                    <p><strong>Filename:</strong> <span x-text="fileInfo.name"></span></p>
                    <p><strong>Size:</strong> <span x-text="fileInfo.size"></span></p>
                    <p><strong>Base64 Length:</strong> <span x-text="base64Output.length"></span> characters</p>
                </div>
                <button @click="copyBase64" class="btn-primary">
                    <i class="fas fa-copy"></i> <span x-text="copyButtonText"></span>
                </button>
            </div>
        </section>

        <section class="tool-section" x-show="mode === 'decode'">
            <div class="input-group">
                <label for="base64Input">Paste your Base64 string:</label>
                <textarea id="base64Input" x-model="base64Input" placeholder="Paste your Base64 string here..." rows="8"></textarea>
                <div class="error" x-show="error" x-text="error"></div>
            </div>

            <div class="input-group">
                <label for="excelFormat">Output format:</label>
                <select id="excelFormat" x-model="outputFormat" class="format-select">
                    <option value="xlsx">.xlsx (Excel Workbook)</option>
                    <option value="xls">.xls (Excel 97-2003)</option>
                    <option value="csv">.csv (Comma-Separated Values)</option>
                </select>
            </div>

            <div class="actions">
                <button @click="decodeExcel" class="btn-primary">Decode &amp; Download</button>
            </div>

            <div class="preview-container" x-show="decodedInfo">
                <h2><i class="fas fa-file-excel"></i> Decoded File</h2>
                <div class="image-info" x-show="decodedInfo">
                    <p><strong>Size:</strong> <span x-text="decodedInfo.size"></span></p>
                    <p><strong>Format:</strong> <span x-text="outputFormat.toUpperCase()"></span></p>
                    <p><strong>Status:</strong> <span style="color:#28a745;">✓ Downloaded</span></p>
                </div>
            </div>
        </section>

        <div class="actions" x-show="base64Output || decodedInfo">
            <button @click="clearAll" class="btn-secondary">Clear</button>
        </div>

        <article class="content-section">
            <h2><i class="fas fa-question-circle"></i> What Is Base64 to Excel Conversion?</h2>
            <p>
                Base64 to Excel conversion encodes a spreadsheet file's binary bytes into a Base64 text string, or decodes that string back into a downloadable <code>.xlsx</code>, <code>.xls</code>, or <code>.csv</code> file. It's the same encoding used for any binary file — Excel workbooks are just treated as raw bytes, since a modern <code>.xlsx</code> file is actually a ZIP archive of XML documents under the hood.
            </p>

            <h2><i class="fas fa-lightbulb"></i> Why Convert Excel Files to Base64?</h2>
            <ul>
                <li><strong>API responses:</strong> Report-generation APIs return exported spreadsheets as a Base64 string inside a JSON payload, avoiding a separate file-download endpoint.</li>
                <li><strong>Email attachments:</strong> MIME email encodes Excel attachments as Base64, per RFC 2045 — see the <a href="/base64-file-encoder/">file encoder</a> for other attachment types.</li>
                <li><strong>Database storage:</strong> Small generated reports get stored directly in a <code>TEXT</code>/<code>BLOB</code> column as a Base64 string.</li>
                <li><strong>No-code / automation tools:</strong> Platforms like Zapier, Make, and n8n frequently pass spreadsheet data between steps as Base64.</li>
            </ul>

            <h2><i class="fas fa-cog"></i> How Does the Base64 Excel Converter Work?</h2>
            <p>
                Encoding reads the uploaded file with the browser's <code>FileReader</code> API and converts the raw bytes to a Base64 string with <code>btoa()</code>. Decoding reverses this: it converts the Base64 string back to bytes with <code>atob()</code>, wraps them in a <code>Blob</code> with the correct MIME type for your chosen format, and triggers a download via <code>URL.createObjectURL()</code>.
            </p>
            <p>
                Because a decoded file has no reliable "Excel" file signature the way a PNG or PDF does — <code>.xlsx</code> shares its ZIP signature with any other ZIP-based format, and <code>.csv</code> is plain text — this tool asks you to pick the output format explicitly rather than guessing.
            </p>

            <h2><i class="fas fa-table"></i> Excel Format Reference</h2>
            <table class="reference-table">
                <thead><tr><th>Format</th><th>MIME Type</th><th>Underlying structure</th></tr></thead>
                <tbody>
                    <tr><td>.xlsx</td><td><code>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</code></td><td>ZIP archive of XML files</td></tr>
                    <tr><td>.xls</td><td><code>application/vnd.ms-excel</code></td><td>Legacy binary OLE format</td></tr>
                    <tr><td>.csv</td><td><code>text/csv</code></td><td>Plain text, comma-delimited</td></tr>
                </tbody>
            </table>
            <p>
                For decoding to JSON, PDF, or a generic file with a custom extension, see the <a href="/base64-to-json/">Base64 to JSON</a>, <a href="/base64-to-pdf/">Base64 to PDF</a>, and <a href="/base64-file-decoder/">general file decoder</a> pages.
            </p>

            <h2><i class="fas fa-shield-alt"></i> Is This Excel Converter Private and Secure?</h2>
            <p>
                Yes. All encoding and decoding runs locally in your browser using the FileReader, Blob, and <code>URL.createObjectURL</code> APIs. Your spreadsheet data — including any sensitive financial or business data it contains — is never uploaded to a server.
            </p>

            <h2>Frequently Asked Questions</h2>

            <div class="faq-item">
                <h3>How do I convert an Excel file to Base64?</h3>
                <p>Click the Encode tab, upload your <code>.xlsx</code>, <code>.xls</code>, or <code>.csv</code> file, and the tool generates a Base64 string instantly.</p>
            </div>

            <div class="faq-item">
                <h3>How do I convert Base64 back to an Excel file?</h3>
                <p>Click the Decode tab, paste the Base64 string, choose the output format (.xlsx, .xls, or .csv), and click Decode &amp; Download.</p>
            </div>

            <div class="faq-item">
                <h3>Why do I have to pick the output format when decoding?</h3>
                <p>Unlike images or PDFs, spreadsheet formats don't have a reliable byte signature the tool can detect automatically — <code>.xlsx</code> is a ZIP file and <code>.csv</code> is plain text. Selecting the format ensures the downloaded file gets the correct extension and MIME type.</p>
            </div>

            <div class="faq-item">
                <h3>Will the decoded file be identical to the original?</h3>
                <p>Yes. Base64 encoding is lossless — the decoded file is byte-for-byte identical to what was originally encoded, as long as the correct output format is selected.</p>
            </div>
        </article>
    </main>`;
---
<ToolLayout
  title="Base64 to Excel Converter — Decode Base64 to XLSX/CSV or Encode Online"
  description="Free online Base64 Excel converter. Decode a Base64 string to a downloadable .xlsx, .xls, or .csv file, or encode a spreadsheet to Base64. Runs entirely in your browser."
  canonical="https://base64image.net/base64-to-excel/"
  h1="Base64 to Excel Converter"
  mono="// XLSX / CSV"
  lede="Decode Base64 to a downloadable Excel or CSV file, or encode a spreadsheet to Base64. Both directions supported — nothing leaves your browser."
  tag="convert"
  tagLabel="Converter"
  breadcrumbs={[{label:'Home',href:'/'},{label:'Converters',href:'#'},{label:'Base64 → Excel'}]}
>
  <Fragment slot="head">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": "How to Convert Excel to Base64 and Base64 to Excel",
        "description": "Step-by-step guide to encode spreadsheet files to Base64 and decode Base64 strings to Excel/CSV",
        "step": [{
            "@type": "HowToStep",
            "name": "Choose Mode",
            "text": "Select Encode to convert an Excel/CSV file to Base64, or Decode to convert Base64 to a spreadsheet file."
        }, {
            "@type": "HowToStep",
            "name": "Upload or Paste",
            "text": "For encoding, upload a .xlsx, .xls, or .csv file. For decoding, paste the Base64 string and choose the output format."
        }, {
            "@type": "HowToStep",
            "name": "Copy or Download",
            "text": "Copy the Base64 string to clipboard, or download the decoded spreadsheet file to your device."
        }]
    }
        </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
            "@type": "Question",
            "name": "How do I convert an Excel file to Base64?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Click the Encode tab, upload your .xlsx, .xls, or .csv file, and the tool generates a Base64 string instantly."
            }
        }, {
            "@type": "Question",
            "name": "How do I convert Base64 back to an Excel file?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Click the Decode tab, paste the Base64 string, choose the output format, and click Decode & Download."
            }
        }, {
            "@type": "Question",
            "name": "Why do I have to pick the output format when decoding?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Spreadsheet formats don't have a reliable byte signature the tool can detect automatically, so selecting the format ensures the correct extension and MIME type."
            }
        }, {
            "@type": "Question",
            "name": "Will the decoded file be identical to the original?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Base64 encoding is lossless — the decoded file is byte-for-byte identical to the original."
            }
        }]
    }
        </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://base64image.net/"
        }, {
            "@type": "ListItem",
            "position": 2,
            "name": "Base64 to Excel Converter",
            "item": "https://base64image.net/base64-to-excel/"
        }]
    }
        </script>
  </Fragment>
  <Fragment set:html={bodyHtml} />
  <style is:inline>
    .format-select {
      width: 100%; background: #06080c; border: 1px solid var(--line);
      border-radius: var(--radius-sm); padding: 12px 14px; color: var(--fg);
      font-family: var(--font-mono); font-size: 13px; outline: none;
    }
    .format-select:focus { border-color: var(--violet); box-shadow: 0 0 0 3px rgba(124,92,255,0.15); }
  </style>
  <script is:inline>function base64ToExcel() {
            const MIME = {
                xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                xls: 'application/vnd.ms-excel',
                csv: 'text/csv'
            };
            return {
                mode: 'encode',
                base64Input: '',
                base64Output: '',
                outputFormat: 'xlsx',
                error: '',
                fileInfo: null,
                decodedInfo: null,
                copyButtonText: 'Copy Base64',

                encodeExcel(event) {
                    this.error = '';
                    this.base64Output = '';
                    this.fileInfo = null;

                    const file = event.target.files[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            const base64String = e.target.result.split(',')[1];
                            this.base64Output = base64String;
                            this.fileInfo = {
                                name: file.name,
                                size: this.formatBytes(file.size)
                            };
                        } catch (err) {
                            this.error = 'Failed to encode file. Please try again.';
                        }
                    };
                    reader.onerror = () => {
                        this.error = 'Failed to read file.';
                    };
                    reader.readAsDataURL(file);
                },

                decodeExcel() {
                    this.error = '';
                    this.decodedInfo = null;

                    if (!this.base64Input.trim()) return;

                    try {
                        let base64String = this.base64Input.trim();
                        const dataUriMatch = base64String.match(/^data:[^;]+;base64,(.+)$/);
                        if (dataUriMatch) base64String = dataUriMatch[1];
                        base64String = base64String.replace(/\s/g, '');

                        if (!/^[A-Za-z0-9+/]*={0,2}$/.test(base64String)) {
                            throw new Error('Invalid Base64 string. Only A-Z, a-z, 0-9, +, /, and = are allowed.');
                        }

                        const binaryString = atob(base64String);
                        const bytes = new Uint8Array(binaryString.length);
                        for (let i = 0; i < binaryString.length; i++) {
                            bytes[i] = binaryString.charCodeAt(i);
                        }

                        const mime = MIME[this.outputFormat] || 'application/octet-stream';
                        const blob = new Blob([bytes], { type: mime });
                        const url = URL.createObjectURL(blob);
                        const filename = 'decoded-spreadsheet.' + this.outputFormat;

                        const link = document.createElement('a');
                        link.href = url;
                        link.download = filename;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                        URL.revokeObjectURL(url);

                        this.decodedInfo = { size: this.formatBytes(bytes.length) };
                    } catch (err) {
                        this.error = err.message || 'Failed to decode Base64 string. Please check your input.';
                        this.decodedInfo = null;
                    }
                },

                formatBytes(bytes) {
                    if (bytes === 0) return '0 Bytes';
                    const k = 1024;
                    const sizes = ['Bytes', 'KB', 'MB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
                },

                copyBase64() {
                    if (!this.base64Output) return;
                    navigator.clipboard.writeText(this.base64Output).then(() => {
                        this.copyButtonText = 'Copied!';
                        setTimeout(() => { this.copyButtonText = 'Copy Base64'; }, 2000);
                    }).catch(() => { this.error = 'Failed to copy to clipboard.'; });
                },

                clearAll() {
                    this.base64Input = '';
                    this.base64Output = '';
                    this.error = '';
                    this.fileInfo = null;
                    this.decodedInfo = null;
                    this.copyButtonText = 'Copy Base64';
                    const fileInput = document.getElementById('excelFile');
                    if (fileInput) fileInput.value = '';
                }
            }
        }</script>
</ToolLayout>
